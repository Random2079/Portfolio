# Copy to .env and adjust
POLL_INTERVAL_SEC=900
DATABASE_URL=sqlite:///./data/news.db
# Day attribution: background MOEX → SQLite every N seconds (default 60)
DAY_POLL_SEC=60
# Optional: limit poll to first N tickers (0 = all)
POLL_LIMIT=0
# K9 toast default: digest | off | each (UI can override per poll)
NOTIFY_DEFAULT=digest
HOST=127.0.0.1
PORT=8765

# BCS Trade API — read-only (НЕ коммитить реальный токен)
# Кабинет БКС → Профиль / счёт → Токены API → refresh token, scope trade-api-read
# Docs: https://trade-api.bcs.ru
BCS_TRADE_REFRESH_TOKEN=
BCS_TRADE_CLIENT_ID=trade-api-read

# F-A: ИИ-чистка ленты (DeepSeek). Ключ не коммитить.
# DEEPSEEK_API_KEY=
# AI_NOISE_ENABLED=false
